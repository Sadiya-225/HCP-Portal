# ------------------------------------------------------------------
# HCP Portal example environment.
# Copy to .env and REPLACE every placeholder value before deploying.
# Never commit real secrets. Passwords must be URL-safe (letters,
# digits, - _ . ~) because Compose builds PostgreSQL URLs from them.
# ------------------------------------------------------------------

# Disable Next.js telemetry locally as well as in Docker (already set
# in the Dockerfile). Keep this set.
NEXT_TELEMETRY_DISABLED=1

# ----- Direct local development (npm run dev) ----------------------
# You normally do NOT need this section at all: `npm run dev`
# auto-generates a secure, gitignored `.env.local` and starts an
# embedded, loopback-only PostgreSQL 17 on port 54329. The values below
# are what it generates (shown for reference). To use your own external
# PostgreSQL instead, create `.env.local` with
# DEV_EMBEDDED_POSTGRES=false and provide both URLs. Compose production
# ignores DEV_EMBEDDED_POSTGRES entirely and uses the internal service
# URLs built from APP_DB_*/MIGRATION_DB_* below — keep credentials
# aligned.
DEV_EMBEDDED_POSTGRES=true
DATABASE_URL=postgresql://hcp_dev:local-dev-password@127.0.0.1:54329/hcp_portal
DATABASE_MIGRATION_URL=postgresql://hcp_dev:local-dev-password@127.0.0.1:54329/hcp_portal

# ----- Compose deployment ------------------------------------------

# Public domain served by Caddy (automatic HTTPS requires a real domain
# pointing at the server with ports 80/443 open).
DOMAIN=portal.example.com

# Email used for Let's Encrypt / ACME registration. Required by the
# included Caddyfile.
ACME_EMAIL=admin@example.com

# PostgreSQL
POSTGRES_DB=hcp_portal
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-url-safe-password

# Application database role (used by the Next.js app; DML only).
APP_DB_USER=hcp_app
APP_DB_PASSWORD=replace-with-a-long-random-url-safe-password

# Migration database role (used by the one-shot migrate service; DDL).
MIGRATION_DB_USER=hcp_migrate
MIGRATION_DB_PASSWORD=replace-with-a-long-random-url-safe-password

# ----- Shared -------------------------------------------------------

# Better Auth
# Generate with: openssl rand -base64 32  (must be at least 32 chars)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public base URL of the app, e.g. https://portal.example.com or
# http://localhost:3000 for local dev.
BETTER_AUTH_URL=https://portal.example.com
# Additional comma-separated trusted origins (optional).
TRUSTED_ORIGINS=

# Database pool size for the app (1-50).
DB_POOL_MAX=10

# Password reset emails. Default off: reset links are never sent unless
# every SMTP setting below is configured AND this is exactly "true".
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
